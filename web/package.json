    "element-resize-detector": "^1.2.4",
    "fingerprintjs2": "^2.1.4",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.3.2",
    "lodash-es": "^4.18.1",
    "mint-filter": "^4.0.3",
    "mitt": "^3.0.1",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.1",
    "pinyin-pro": "^3.29.5",
    "print-js": "^1.6.0",
